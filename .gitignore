# ============================================================================
# СППВР — .gitignore
# Секреты, БД пациентов и локальные данные НИКОГДА не попадают в репозиторий.
# ============================================================================

# --- Секреты (пример конфигурации коммитится, реальный .env — нет) ----------
.env
.env.*
!.env.example

# --- Данные: БД SQLite с пациентами, шифрованное хранилище, загрузки --------
# /db целиком вне git, кроме .gitkeep (чтобы клон репозитория содержал папку)
/db/*
!/db/.gitkeep
/private-storage/
/public/uploads/
# Пользовательские загрузки (могут содержать пациентские данные!)
/upload/
*.db
*.db-journal
*.db-wal
*.db-shm

# --- Зависимости ------------------------------------------------------------
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Next.js ---------------------------------------------------------------
/.next/
/out/
/build
# Скачиваемые архивы исходников (генерируются git archive, в git не нужны)
/public/*.zip
next-env.d.ts

# --- Логи и отладка ---------------------------------------------------------
*.log
dev.log
dev.out.log
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# --- Рабочие артефакты среды разработки (не часть приложения) ---------------
/worklog.md
/tool-results/
/.zscripts/
/tests/
/download/
/agent-ctx/

# --- Инструменты ------------------------------------------------------------
.DS_Store
*.pem
.vercel
/coverage
local-*
.claude
.z-ai-config
/skills/

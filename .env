# ============================================================================
# СППВР — шаблон переменных окружения
# ----------------------------------------------------------------------------
# 1. Скопируйте:  cp .env.example .env
# 2. При первом `bun run dev` скрипт ensure-env.ts автоматически допишет
#    отсутствующие секреты (JWT_SECRET, ENCRYPTION_KEY) и настройки ИИ.
# 3. Файл .env НИКОГДА не коммитится в репозиторий (см. .gitignore).
# ============================================================================

# --- База данных (SQLite; путь относительный — от prisma/schema.prisma) ------
DATABASE_URL=file:../db/custom.db

# --- Серверные секреты (генерируются автоматически при отсутствии) -----------
# JWT_SECRET=
# ENCRYPTION_KEY=

# ============================================================================
# ИИ-ПРОВАЙДЕР — локальный OpenAI-совместимый сервер
# ============================================================================
# Провайдер: llama-server (llama.cpp) ИЛИ lm-studio (LM Studio)
AI_PROVIDER=llama-server

# --- llama-server (llama.cpp):  .\llama-server.exe -m model.gguf --port 8080 --
LLAMA_SERVER_URL=http://127.0.0.1:8080/v1
LLAMA_SERVER_MODEL=
LLAMA_SERVER_API_KEY=

# --- LM Studio (альтернатива: AI_PROVIDER=lm-studio) -------------------------
LM_STUDIO_ENABLED=true
LM_STUDIO_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=
LM_STUDIO_API_KEY=

# --- Общие параметры ИИ (AI_* приоритетнее LM_STUDIO_*) ----------------------
# Тайм-аут LLM-запроса, мс (CPU-модель на 8K токенов: 5-8 минут)
LM_STUDIO_TIMEOUT_MS=600000
# Idle-тайм-аут streaming-ответа, мс
LM_STUDIO_IDLE_TIMEOUT_MS=180000
LM_STUDIO_MAX_RETRIES=2
LM_STUDIO_RETRY_BASE_DELAY_MS=1000
LM_STUDIO_TEMPERATURE=0.2
LM_STUDIO_MAX_TOKENS=8192
LM_STUDIO_HEALTH_TIMEOUT_MS=3000
LM_STUDIO_HEALTH_CACHE_MS=15000
# Доп. хосты ИИ-сервера помимо localhost, через запятую (SSRF-защита)
LM_STUDIO_EXTRA_ALLOWED_HOSTS=

# ============================================================================
# СЕТЬ / Network Health (circuit breaker, probes)
# ============================================================================
NETWORK_PROBE_INTERVAL_MS=60000
NETWORK_PROBE_TIMEOUT_MS=8000
NETWORK_OFFLINE_AFTER_FAILURES=2
NETWORK_CIRCUIT_FAILURE_THRESHOLD=4
NETWORK_CIRCUIT_COOLDOWN_MS=30000

# ============================================================================
# ИИ-КОНВЕЙЕР (анализ кейсов)
# ============================================================================
# Глубокий анализ: черновик -> самопроверка ИИ
AI_DEEP_ANALYSIS=true
AI_SELF_VERIFY_PASSES=1
AI_TEMPERATURE_ANALYSIS=0.2
AI_MAX_TOKENS_ANALYSIS=8192

# ============================================================================
# МЕЖДУНАРОДНЫЕ ИСТОЧНИКИ ЗНАНИЙ (web RAG: PubMed/ВОЗ/NICE/Cochrane/CDC/ESC)
# ============================================================================
INTL_RAG_ENABLED=true
INTL_RAG_MAX_RESULTS=6
INTL_RAG_TIMEOUT_MS=12000
JWT_SECRET=9dfcd3febdfd9b52ed47b8bb6d2fdb2173477d799b216e1a011c319abe7d5ab6
ENCRYPTION_KEY=5a55b0b8986ecec5f36504799a33546e2780c738e70f71453bd319149544eb5d
